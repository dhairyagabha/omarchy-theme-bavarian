# Bavarian — carbon, alpine white, Bavarian blue. Generated by bin/generate-theme.py.

# Carbon.
theme[main_bg]="#08090C"
# Body text.
theme[main_fg]="#D9DDE3"
# Box titles.
theme[title]="#E9EBEF"
# Keyboard shortcuts — the accent, because they are the interaction.
theme[hi_fg]="#2C7FD4"
# Deep ALPINA blue.
theme[selected_bg]="#0A2E6B"
theme[selected_fg]="#E9EBEF"
# Disabled text.
theme[inactive_fg]="#6C7480"
# Mini graphs and detail text.
theme[proc_misc]="#4FB8CE"
# Box outlines — machined aluminium hairline.
theme[cpu_box]="#232833"
theme[mem_box]="#232833"
theme[net_box]="#232833"
theme[proc_box]="#232833"
# Divider lines.
theme[div_line]="#232833"

# Graph gradients. Each sweeps cool to warm; red is reserved for load
# that actually deserves attention.
theme[temp_start]="#5FA97D"
theme[temp_mid]="#D89A4E"
theme[temp_end]="#D2544A"
theme[cpu_start]="#5AA9F0"
theme[cpu_mid]="#4FB8CE"
theme[cpu_end]="#D89A4E"
theme[free_start]="#417155"
theme[free_mid]="#5FA97D"
theme[free_end]="#7FC79B"
theme[cached_start]="#367b8a"
theme[cached_mid]="#4FB8CE"
theme[cached_end]="#74D4E8"
theme[available_start]="#1f568e"
theme[available_mid]="#2C7FD4"
theme[available_end]="#5AA9F0"
theme[used_start]="#D89A4E"
theme[used_mid]="#D2544A"
theme[used_end]="#E06A5F"
theme[download_start]="#3d71a0"
theme[download_mid]="#5AA9F0"
theme[download_end]="#74D4E8"
theme[upload_start]="#8f6737"
theme[upload_mid]="#D89A4E"
theme[upload_end]="#EBBA74"
